# Copy to .env — never commit real keys. Free-only stack.
# LLM: OpenRouter primary, Pollinations.ai free fallback (no key needed).
# Leave OPENROUTER_API_KEY empty for pure rule-based mode (evals stay offline).
OPENROUTER_API_KEY=
LLM_MODEL=openrouter/auto
POLLINATIONS_MODEL=openai
# Set to 1 to let the LLM polish result summaries (numbers/cites pass through
# untouched; original kept on any failure). Default 0 = deterministic.
ACCUPAID_LLM_ENHANCE=0
# Tracing + eval datasets
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AccuPaid-startup
# RAG (Qdrant via docker; fallback Chroma local dir)
QDRANT_URL=http://localhost:6333
CHROMA_DIR=.chroma
# MCP server URL (SSE) — stdio is default for local dev
MCP_URL=http://localhost:8001/sse
# Browser console origin for CORS (comma-separated)
CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
# Approval links: HMAC secret + 15-min expiry
APPROVAL_HMAC_SECRET=change-me-in-prod
APPROVAL_TTL_SECONDS=900
# Pilot phase
DATABASE_URL=sqlite:///./accupaid.db
# POSTGRES_DSN=postgresql://user:pass@localhost:5432/accupaid
