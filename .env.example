# Copy to .env — never commit real keys. Free-only stack.
# LLM (one of the two is enough for the weekend build)
OPENAI_API_KEY=
GROQ_API_KEY=
# Tracing + eval datasets
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AccuPaid-startup
# RAG (Qdrant via docker; fallback Chroma local dir)
QDRANT_URL=http://localhost:6333
CHROMA_DIR=.chroma
# MCP server URL (SSE) — stdio is default for local dev
MCP_URL=http://localhost:8001/sse
# Approval links: HMAC secret + 15-min expiry
APPROVAL_HMAC_SECRET=change-me-in-prod
APPROVAL_TTL_SECONDS=900
# Pilot phase
DATABASE_URL=sqlite:///./accupaid.db
# POSTGRES_DSN=postgresql://user:pass@localhost:5432/accupaid
